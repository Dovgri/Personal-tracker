extends layout

block scripts
    script(src='/javascripts/books.js')

block content
  .insert_book
    h2 Pridėti naują knygą
    form(action='/books', method='post')
      input(type='text', placeholder='Knygos pavadinimas...', required, name='title')
      br
      input(type='text', placeholder='Autorius...', required, name='author')
      br
      input(type='text', placeholder='Žanras...', required, name='genre')
      br
      input(type='submit', value='Pridėti knygą')
    .search_book
        h2 Ieškoti knygos
        form(action='/books', method='get')
            input(type='text', placeholder='Ieškoti knygos...', required, name='searchbar')
            br
            input(type='submit', value='Ieškoti')
    .book_list
        h2 Knygų sąrašas`