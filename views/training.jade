extends layout

block content
    .week
        h1.single_day Monday
        h1.single_day Tuesday
        h1.single_day Wednesday
        h1.single_day Thursday
        h1.single_day Friday
        h1.single_day Saturday
        h1.single_day Sunday
    .new_exercise
        h2 Add new exercise
        form(action='/training', method='post')
            input(type='text', placeholder='Search for exercise...')
            br
            input(type='text', placeholder='sets...')
            br
            input(type='text', placeholder='reps...')
            br
            input(type='submit', value='Add exercise')
    .exercise_table
        h1 Exercises
        table
            tr
                th Exercise
                th Sets
                th Reps
                th Weight 
                th Previous
            tr
                td Bench press
                td 3
                td 10
                td 100
                td 90
            tr
                td Squats
                td 4
                td 12
                td 120
                td 110
